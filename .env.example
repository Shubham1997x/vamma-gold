# SQLite database file, managed by Prisma. Resolved relative to prisma/, so this
# points at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies. Set a long random value in production.
SESSION_SECRET=

# Password for the seeded "admin" account, used only the first time the DB is created.
ADMIN_INITIAL_PASSWORD=
